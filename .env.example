# DOF Chat - Environment Configuration Example
# Copy this file to .env and update with your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection URL with asyncpg driver for async operations
DATABASE_URL=postgresql+asyncpg://username:password@host:port/database
# =============================================================================
# GEMINI API CONFIGURATION
# =============================================================================
# Google Gemini API key for LLM generation
# Get your API key from: https://aistudio.google.com/app/api-keys
# Leave empty for development/testing with mock responses
GEMINI_API_KEY=

# Gemini model to use for generation
GEMINI_MODEL=gemini-1.5-flash

# =============================================================================
# EMBEDDING MODEL CONFIGURATION
# =============================================================================
# Hugging Face model for text embeddings
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Embedding vector dimension (must match model output)
EMBEDDING_DIMENSION=1024

# Maximum sequence length for embedding model
MODEL_MAX_SEQ_LENGTH=1024

# =============================================================================
# DEVICE CONFIGURATION
# =============================================================================
# Compute device for embedding model: "cpu", "cuda", or "mps" (Mac)
DEVICE=cpu

# =============================================================================
# RAG CONFIGURATION
# =============================================================================
# Task description for embedding model instruction
TASK_DESCRIPTION=Retrieve relevant legal document fragments including text, image descriptions, and table content that match the query

# Maximum number of document chunks to retrieve per query
MAX_CHUNKS=5

# Force mock mode (bypass real models, use mock responses for testing)
# Set to "true" or "false"
FORCE_MOCK_MODE=false

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application display name
APP_NAME=DOF Chat

# Enable debug mode (set to "false" in production)
DEBUG=true

# Session secret key for signing cookies (CHANGE IN PRODUCTION!)
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=change-me-in-production

CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key

CLERK_SECRET_KEY=your-clerk-secret-key
